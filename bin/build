#!/usr/bin/env bash
#
# Canonical compiler rebuild — SELF-HOST by default.
#
#   bin/build [--seed] [--auto-seed] [--verify] [--fast] [output]
#
# Manticore builds Manticore. The self-built `bin/manticore` is the
# canonical builder; the Zend front-end (`bin/compile`) is only the COLD
# bootstrap seed used when no working binary exists yet.
#
#   default        self-host: bin/manticore compiles src/ -> new bin/manticore
#                  (falls back to the Zend seed automatically if no binary)
#   --seed         force the cold bootstrap (Zend front-end via bin/compile)
#   --auto-seed    on a BOOTSTRAP GAP (below), escalate to the cold seed
#                  instead of failing — for CI, where nobody reads the advice
#   --verify       after rebuilding, run the fixpoint + suite gate
#   --fast         ITERATION build: -O1, application only, to
#                  bin/manticore.fast. Never swaps bin/manticore and never
#                  rebuilds lib/*.o — a slower binary in the canonical slot
#                  would slow every later build, and a -O1 stdlib would slow
#                  every user program. -O1 costs ~3% on the compiler's own
#                  speed and takes ~14% off the build wall (measured
#                  2026-09-07: 71 s vs 83 s). A green --fast build is NOT
#                  gate evidence: the sjlj-locals bug was right at -O0 and
#                  wrong at -O2.
#   output         target path (default bin/manticore)
#
# The self build goes to a temp path, is smoke-tested (compile+run a
# trivial program), and only then atomically swapped into place — a
# broken self build never clobbers the working binary.
#
# TWO PASSES, and the order is the point. The manifest holds a library target
# (lib/manticore_stdlib.o) and an application target (the compiler). Building
# both in ONE `manticore build` means the CURRENT binary produces both — so the
# stdlib every user program links is always one generation behind the compiler
# that will compile them, and a change to src/Runtime only takes effect on the
# NEXT rebuild. Hence:
#
#   pass 1  --apps-only : the running compiler builds the new compiler
#   swap    smoke-test, keep the old binary as bin/.manticore.prev
#   pass 2  --libs-only : the NEW compiler builds lib/manticore_stdlib.o(.sig)
#
# Safe in that order because the compiler application is "stdlib": false — it
# embeds src/Runtime itself and never links the library it is about to rebuild.
#
# BOOTSTRAP GAP: the one thing a self-host build cannot do is build source that
# needs a compiler newer than itself — a call to a codegen builtin this binary
# does not know (it compiles into a silent "Call to undefined function" trap
# rather than a link error), or syntax its parser cannot read. Both are detected
# BEFORE the swap, named, and reported; the answer is a cold seed. See the
# "PHP body first, codegen builtin second" rule in src/Runtime/Stdlib/README.md
# for how to add a builtin that needs no seed at all.

set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

# The self build lands on a temp path and is smoke-tested THERE, so its
# argv0-relative prelude lookup can't reach repo/prelude. Point it at the
# canonical dir, as tools/selfhost.sh does for the same reason.
export MANTICORE_PRELUDE="$ROOT/prelude"

SEED=0
AUTOSEED=0
VERIFY=0
FAST=0
OUT="bin/manticore"
OUT_GIVEN=0
for arg in "$@"; do
    case "$arg" in
        --seed)      SEED=1 ;;
        --auto-seed) AUTOSEED=1 ;;
        --verify)    VERIFY=1 ;;
        --fast)      FAST=1 ;;
        -*)          echo "unknown flag: $arg" >&2; exit 2 ;;
        *)           OUT="$arg"; OUT_GIVEN=1 ;;
    esac
done

# --fast exists to keep a fast, non-canonical binary OUT of the canonical slot.
# Every combination that would defeat that is refused rather than silently
# downgraded.
if [[ $FAST -eq 1 ]]; then
    if [[ $OUT_GIVEN -eq 0 ]]; then OUT="bin/manticore.fast"; fi
    if [[ "$OUT" == "bin/manticore" ]]; then
        echo "bin/build: --fast refuses to write bin/manticore — that binary builds" >&2
        echo "  every later generation, and a -O1 copy would slow all of them." >&2
        echo "  Use \`bin/build\` for the canonical slot, \`bin/build --fast\` to iterate." >&2
        exit 2
    fi
    if [[ $VERIFY -eq 1 ]]; then
        echo "bin/build: --fast and --verify are contradictory — a -O1 build is not" >&2
        echo "  gate evidence (sjlj-locals was right at -O0 and wrong at -O2)." >&2
        exit 2
    fi
    if [[ $SEED -eq 1 ]]; then
        echo "bin/build: --fast has no meaning for the cold Zend seed (--seed)" >&2
        exit 2
    fi
fi

if [[ $SEED -eq 0 && ! -x bin/manticore ]]; then
    echo "no bin/manticore yet — cold bootstrap via Zend seed" >&2
    SEED=1
fi

# A bootstrap gap: explain it, and either escalate or stop. Terminal either way
# — the caller is mid-self-host and must not continue with a compiler that
# cannot build its own source.
bootstrap_gap() {
    echo "" >&2
    echo "bin/build: this compiler cannot build the new src/ — $1" >&2
    if [[ $AUTOSEED -eq 1 ]]; then
        echo "bin/build: --auto-seed → escalating to the cold Zend bootstrap" >&2
        bin/compile "$OUT"
        if [[ $VERIFY -eq 1 ]]; then
            echo "── verify: fixpoint + suite gate ──"
            bash tools/selfhost_fixpoint.sh
        fi
        exit 0
    fi
    echo "" >&2
    echo "  rerun with \`bin/build --seed\` (cold Zend bootstrap, ~2 min)," >&2
    echo "  or \`bin/build --auto-seed\` to escalate automatically." >&2
    echo "" >&2
    echo "  A new codegen builtin needs no seed if it ships with a same-named" >&2
    echo "  PHP body (as strpos/array_keys already do): the old compiler links" >&2
    echo "  the body, the new one inlines the builtin." >&2
    exit 1
}

# Whether the INSTALLED binary understands a CLI flag this script wants to pass.
# It is one generation behind by construction — the flag may have been added by
# the very source it is about to compile — and ArgParse answers 64 for an
# unknown option, which no other failure uses. Probed against a manifest path
# that cannot exist, so a supported flag fails later (66, cannot read) and
# nothing is built either way.
supports_flag() {
    local rc=0
    "$@" >/dev/null 2>&1 || rc=$?
    [[ $rc -ne 64 ]]
}

if [[ $SEED -eq 0 ]]; then
    # Preflight, ~2 s and no codegen: the closed-world undefined-symbol rules
    # plus parse errors, asked of THIS binary about the NEW source. A name it
    # cannot resolve is precisely what would become a throw stub below.
    if supports_flag bin/manticore analyze --only undefined. /nonexistent-preflight-probe.php; then
        echo "── preflight: can this compiler resolve src/? ──"
        if ! bin/manticore analyze src --only undefined.,parse.error; then
            bootstrap_gap "unresolved symbols / parse errors above"
        fi
    else
        echo "── preflight skipped (installed compiler predates \`analyze --only\`) ──"
    fi
fi

if [[ $SEED -eq 1 ]]; then
    echo "── cold bootstrap: Zend front-end (bin/compile) ──"
    bin/compile "$OUT"
else
    echo "── self-host pass 1: bin/manticore build --apps-only ──"
    # Single source of truth: the manifest defines the self-contained
    # compiler target. Build to a temp output, smoke-test, then atomically
    # swap — a broken self build never clobbers the working binary.
    TMP="$(mktemp -d)/manticore_new"
    TMP_MANIFEST="$(mktemp).json"
    BUILD_LOG="$(mktemp)"
    # Redirect the manifest's output to the temp path (the only edit). What is
    # rewritten is the path the MANIFEST names, not $OUT: $OUT is where the
    # smoke-tested result is installed, and the two differ whenever a target
    # path is given (--fast, or an explicit output argument).
    MANIFEST_OUT="bin/manticore"
    sed "s#\"$MANIFEST_OUT\"#\"$TMP\"#" manticore.json > "$TMP_MANIFEST"
    if ! grep -q "\"$TMP\"" "$TMP_MANIFEST"; then
        echo "fatal: manticore.json has no application output '$MANIFEST_OUT' to redirect" >&2
        exit 1
    fi
    # An installed compiler that predates --apps-only builds both targets in one
    # pass, the old way. Pass 2 below then rebuilds the libraries with the new
    # binary regardless, so the generation skew is closed either way.
    APPS_ONLY="--apps-only"
    if ! supports_flag bin/manticore build --apps-only /nonexistent-manifest-probe.json; then
        APPS_ONLY=""
        echo "   (installed compiler predates --apps-only — one-pass build, libraries rebuilt in pass 2)"
    fi
    # --fast asks for -O1. Probed, because an installed compiler one generation
    # back may not take -O on `build` at all; falling back to its default is
    # correct-but-slower, never wrong.
    OPT_FLAG=""
    if [[ $FAST -eq 1 ]]; then
        if supports_flag bin/manticore build -O1 /nonexistent-manifest-probe.json; then
            OPT_FLAG="-O1"
            echo "   (--fast: -O1, application only, -> $OUT — NOT gate evidence)"
        else
            echo "   (installed compiler predates -O on \`build\` — building at its default)"
        fi
    fi
    set +e
    # shellcheck disable=SC2086
    bin/manticore build $APPS_ONLY $OPT_FLAG "$TMP_MANIFEST" 2>&1 | tee "$BUILD_LOG"
    BUILD_RC="${PIPESTATUS[0]}"
    set -e
    [[ $BUILD_RC -eq 0 ]] || { echo "fatal: self build failed (rc=$BUILD_RC)" >&2; exit 1; }
    # The emitter reports every call it compiled into an undefined-function
    # trap. In the compiler's OWN source that is never intentional — there is no
    # `extension_loaded()` guard in src/ — so treat any as the bootstrap gap.
    if grep -q "undefined-function traps" "$BUILD_LOG"; then
        grep "undefined-function traps" "$BUILD_LOG" >&2
        bootstrap_gap "it compiled calls in src/ into runtime traps (above)"
    fi

    echo "── smoke test the self build ──"
    echo '<?php echo "selfhost-ok\n";' > "$TMP.smoke.php"
    if ! "$TMP" compile "$TMP.smoke.php" -o "$TMP.smoke" >/dev/null 2>&1; then
        bootstrap_gap "the compiler it produced cannot compile hello world"
    fi
    OUTPUT="$("$TMP.smoke" || true)"
    if [[ "$OUTPUT" != "selfhost-ok" ]]; then
        bootstrap_gap "the compiler it produced miscompiles hello world (got '$OUTPUT')"
    fi

    # Keep the outgoing binary: a later gap can retry from HERE instead of from
    # Zend, and the checkout is never left without a working compiler. A --fast
    # build writes its own path and touches neither the canonical binary nor the
    # rescue copy.
    if [[ $FAST -eq 0 && -x "$OUT" ]]; then cp "$OUT" "bin/.manticore.prev"; fi
    mv "$TMP" "$OUT"
    if [[ $FAST -eq 0 ]]; then echo "ok: $OUT (self-built via manifest, smoke-tested)"; fi

    if [[ $FAST -eq 1 ]]; then
        echo "ok: $OUT (--fast, -O1, apps only). lib/*.o untouched — this binary links"
        echo "    the stdlib bin/manticore built. Promote with a plain \`bin/build\`."
        exit 0
    fi

    echo "── self-host pass 2: $OUT build --libs-only (stdlib rebuilt by the NEW compiler) ──"
    "$OUT" build --libs-only manticore.json
    # A library's .sig is its whole reason to exist, and it can come out EMPTY
    # while every other signal stays green: the .o is full of symbols, pass 2
    # exits 0, and nothing fails until a user program calls one and clang says
    # `use of undefined value`. That is exactly what happened — emission had
    # been taught to drain `$module->functions`, which is the table Sig walks,
    # and 531 of 1028 AOT cases went red behind a build that reported success.
    # An interface with no functions in it is never correct, so say so here.
    SIG="lib/manticore_stdlib.o.sig"
    if [[ ! -s "$SIG" ]] || ! grep -q '"functions":\[{' "$SIG"; then
        echo "" >&2
        echo "bin/build: $SIG declares NO functions — the stdlib interface is empty." >&2
        echo "  The object may still be full of symbols; every dependent will fail" >&2
        echo "  clang with \`use of undefined value\`. Do not ship this build." >&2
        exit 1
    fi
    echo "ok: lib/manticore_stdlib.o (built by $OUT)"
fi

if [[ $VERIFY -eq 1 ]]; then
    echo "── verify: fixpoint + suite gate ──"
    bash tools/selfhost_fixpoint.sh
fi
