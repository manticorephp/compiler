# Self-compile artifacts. Only the driver script is checked in.
#
# The wildcards matter: tools/selfhost.sh writes manticore_self{,.ll,_stubs.c}
# here, and a 954k-line .ll that is neither tracked nor ignored rides into the
# next `git add -A` — which is exactly how it got committed once.
manticore
.manticore.prev
manticore.ll
manticore.o
manticore_stubs.c
manticore_stubs.o
manticore_self*
manticore_g[0-9]*
# tools/prof/live.sh --build: the no-pool compiler it profiles
manticore.nopool
# tools/prof A/B and fixpoint generations
manticore.base
manticore.chg*
manticore.noarena
manticore.g*

# Anything ELSE compiled into bin/ is a probe: name-by-name rules kept losing
# the race (bin/scan1, and a dozen http/leak probes in one `git add -A`), so
# ignore the whole directory and list what is genuinely checked in.
/*
!/.gitignore
!/build
!/compile
!/manticore-install