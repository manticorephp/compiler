T_NAME_QUALIFIED Use\C | ;
T_NAME_QUALIFIED yield\x | ;
T_NAME_QUALIFIED yield\from | ;
T_NAME_QUALIFIED __CLASS__\x | ;
T_NAME_QUALIFIED fn\x | ;
T_NAME_QUALIFIED enum\x | ;
T_NAME_QUALIFIED static\x | ;
T_NAME_QUALIFIED isset\x | ;
T_NAME_QUALIFIED array\x | ;
T_VARIABLE $o | T_OBJECT_OPERATOR -> | T_STRING use | T_NAME_FULLY_QUALIFIED \C | ;
T_VARIABLE $o | T_NULLSAFE_OBJECT_OPERATOR ?-> | T_STRING foo | T_NAME_FULLY_QUALIFIED \bar | ;
T_STRING A | T_DOUBLE_COLON :: | T_NAME_QUALIFIED class\x | ;
T_NAME_RELATIVE namespace\A\b | ;
T_NAME_RELATIVE Namespace\A | ;
T_FUNCTION function | T_NAME_QUALIFIED use\x | ( | ) | { | }
T_NAME_FULLY_QUALIFIED \use\x | ;
