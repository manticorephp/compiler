-- mutate
array(1) {
  ["a"]=>
  string(1) "2"
}
array(1) {
  ["a"]=>
  string(1) "3"
}
-- named+int
array(2) {
  ["a"]=>
  int(13)
  ["b"]=>
  int(4)
}
-- null int
array(1) {
  ["a"]=>
  NULL
}
array(1) {
  ["a"]=>
  int(5)
}
-- bindValue after
array(1) {
  ["a"]=>
  string(1) "7"
}
-- bindParam after bindValue
array(1) {
  ["a"]=>
  string(1) "2"
}
-- execute arr clears
array(1) {
  ["a"]=>
  string(1) "9"
}
array(1) {
  ["a"]=>
  string(1) "9"
}
-- loop
array(2) {
  [0]=>
  array(2) {
    [0]=>
    int(1)
    [1]=>
    string(1) "x"
  }
  [1]=>
  array(2) {
    [0]=>
    int(2)
    [1]=>
    string(1) "y"
  }
}
-- inout
bool(true)
array(1) {
  ["a"]=>
  string(3) "abc"
}
string(3) "abc"
-- maxlen
bool(true)
array(1) {
  ["a"]=>
  string(6) "abcdef"
}
