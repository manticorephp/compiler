{
    "applications": [
        {
            "name": "symfony-app",
            "src": "src",
            "entry": "public/index.php",
            "output": "bin/app",
            "composer": true,
            "allowUndefined": ["apcu_*","Memcached","RedisCluster","Relay\\*","Symfony\\Component\\ExpressionLanguage\\*","Symfony\\Component\\Serializer\\*"],
            "extensions": [
                "compat"
            ]
        }
    ],
    "extensions": {
        "compat": {
            "src": "compat"
        }
    }
}
